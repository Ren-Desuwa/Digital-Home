{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci --include=dev --include=optional --no-audit --no-fund",
  "buildCommand": "npm --prefix web run build:builder",
  "outputDirectory": "web/dist-builder",
  "rewrites": [{ "source": "/builder", "destination": "/index.html" }],
  "headers": [{ "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
