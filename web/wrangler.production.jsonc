{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-home",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digital-home-prod",
      "database_id": "518d6819-d526-410b-b084-5c83dff03465",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://digital-home.ren-desuwa.workers.dev"
  }
}
